# Server-side only. Never expose this value through NEXT_PUBLIC_*.
OPENAI_API_KEY=

# Optional. The tested default is used when this is omitted.
OPENAI_STORY_MODEL=gpt-5.6-sol

# Hosted retrieval is optional; runtime falls back to committed sanitized cards.
OPENAI_RAG_ENABLED=false
OPENAI_STORY_VECTOR_STORE_ID=

# Set to true to demo deterministic fallbacks without calling OpenAI.
OPENAI_FIXTURE_MODE=false
