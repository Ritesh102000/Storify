# Required. Server-side only. Never commit the real value and never expose it
# through NEXT_PUBLIC_*.
OPENAI_API_KEY=

# Story and world generation. These are the tested local-demo defaults.
OPENAI_STORY_MODEL=gpt-5.6-sol
OPENAI_WORLD_MODEL=gpt-5.6-terra
OPENAI_WORLD_REASONING_EFFORT=medium
OPENAI_DETECTIVE_MODEL=gpt-5.6-terra

# Production-grade story simulator. The model writes creative plans and prose;
# the server still owns state changes, legality, continuity, and persistence.
OPENAI_DIRECTOR_MODEL=gpt-5.6-terra
OPENAI_CHARACTER_MODEL=gpt-5.6-terra
OPENAI_FILTER_MODEL=gpt-5.6-terra
OPENAI_RENDERER_MODEL=gpt-5.6-sol
OPENAI_CRITIC_MODEL=gpt-5.6-terra
OPENAI_DIRECTOR_REASONING_EFFORT=medium

# Character Forge: interview, reference-image understanding, portrait creation,
# and microphone transcription all use the same OPENAI_API_KEY above.
FORGE_TEXT_MODEL=gpt-5.6-luna
FORGE_VISION_MODEL=gpt-5.6-luna
FORGE_IMAGE_MODEL=gpt-image-2
FORGE_TRANSCRIBE_MODEL=gpt-4o-transcribe

# Hosted retrieval is optional; runtime falls back to committed sanitized cards.
OPENAI_RAG_ENABLED=false
OPENAI_STORY_VECTOR_STORE_ID=

# Set to true to demo deterministic fallbacks without calling OpenAI.
OPENAI_FIXTURE_MODE=false
